{{block "resources" .}}
<div tabindex="0" class="collapse collapse-open collapse-arrow bg-neutral text-neutral-content shadow-xl">
  <input type="checkbox" />
  <div class="collapse-title text-xl font-medium">Select a resource</div>
  <div class="collapse-content">
      <ul class="menu gap-2 bg-base-200 rounded-box">
        {{range .DropdownData.Items}} {{template "resource_item" .}} {{end}}
      </ul>
    </div>
</div>
{{end}}
